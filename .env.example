# Copy to cloud secrets. Never commit actual values.
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
CORS_ORIGINS=["https://YOUR_FRONTEND.example"]
WORKSPACE_URL=https://YOUR_FRONTEND.example
# Enable only after golden-set review and configuring actual provider model IDs.
LLM_ENABLED=false
LLM_PROVIDER=openai
OPENAI_API_KEY=
# DeepSeek preset: LLM_PROVIDER=deepseek, CHEAP_MODEL=DEEP_MODEL=deepseek-flash.
DEEPSEEK_API_KEY=
# Third-party endpoint: LLM_PROVIDER=openai_compatible, CHEAP_MODEL=DEEP_MODEL=your model.
LLM_API_KEY=
LLM_BASE_URL=
LLM_API_FORMAT=chat_completions
# Confirm effective RMB rates including all provider multipliers before enabling.
# Blank means unpriced: custom LLM activation is refused. A package price is not a token rate.
LLM_INPUT_CNY_PER_MILLION=
LLM_OUTPUT_CNY_PER_MILLION=
DAILY_BUDGET_CNY=20
# DeepSeek uses min(DAILY_TOKEN_LIMIT, DAILY_BUDGET_CNY * 1M / 8) as a conservative
# global cap at current peak prices. At 20 CNY, set DAILY_TOKEN_LIMIT=2500000.
# DeepSeek embeddings are unavailable; keyword search remains available.
CHEAP_MODEL=gpt-4.1-mini
DEEP_MODEL=gpt-4.1
EMBEDDING_MODEL=text-embedding-3-small
DAILY_TOKEN_LIMIT=1000000
TIMEZONE=Asia/Shanghai
SEMANTIC_SCHOLAR_API_KEY=
ARXIV_CATEGORIES=["cs.AI","cs.CL","cs.LG","cs.DC"]
SOURCE_USER_AGENT=TeamResearchCopilot/0.1 (contact: YOUR_EMAIL)
ENABLE_HF=true
# Public source responses and extracted text persist in Postgres, not ephemeral container disk.
HTTP_CACHE_HOURS=12
USE_CACHE_ONLY=false
SHORTLIST_SIZE=20
DEEP_COUNT=5
EXPLORATION_RATIO=0.2
# Optional outbound delivery. Blank means only persist in-app digests, send nothing.
IM_PROVIDER=
IM_WEBHOOK_URL=
IM_TEAM_ID=
# Optional email via Resend; individual opt-in required in profile.
RESEND_API_KEY=
EMAIL_FROM=
# Optional direct SMTP alternative for personal digests; separate from Supabase Auth SMTP.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
