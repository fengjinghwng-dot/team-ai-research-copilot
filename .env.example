# Copy to cloud secrets. Never commit actual values.
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
CORS_ORIGINS=["https://YOUR_FRONTEND.example"]
WORKSPACE_URL=https://YOUR_FRONTEND.example
# Enable only after golden-set review and configuring actual provider model IDs.
LLM_ENABLED=false
OPENAI_API_KEY=
CHEAP_MODEL=gpt-4.1-mini
DEEP_MODEL=gpt-4.1
EMBEDDING_MODEL=text-embedding-3-small
DAILY_TOKEN_LIMIT=1000000
TIMEZONE=Asia/Shanghai
SEMANTIC_SCHOLAR_API_KEY=
ARXIV_CATEGORIES=["cs.AI","cs.CL","cs.LG","cs.DC"]
SOURCE_USER_AGENT=TeamResearchCopilot/0.1 (contact: YOUR_EMAIL)
ENABLE_HF=true
# Public source responses and extracted text persist in Postgres, not ephemeral container disk.
HTTP_CACHE_HOURS=12
USE_CACHE_ONLY=false
SHORTLIST_SIZE=20
DEEP_COUNT=5
EXPLORATION_RATIO=0.2
# Optional outbound delivery. Blank means only persist in-app digests, send nothing.
IM_PROVIDER=
IM_WEBHOOK_URL=
IM_TEAM_ID=
# Optional email via Resend; individual opt-in required in profile.
RESEND_API_KEY=
EMAIL_FROM=
